@* File: Views/Dashboard/Index.cshtml *@
@using WindMonitoringSystem.Models
@model IEnumerable<WindReading>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="fade-in-up">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="mb-0" style="font-size:1.6rem;font-weight:700;">
            <i class="bi bi-speedometer2 me-2" style="color:var(--accent);"></i>Live Dashboard
        </h1>
        <span class="text-muted small" id="last-updated">Last updated: —</span>
    </div>

    <!-- Stale Data Warning -->
    <div class="stale-warning" id="stale-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        No new reading in the past 30 seconds. Sensor may be offline.
    </div>

    <div class="row g-4 mb-4">

        <!-- Wind Speed Gauge Card -->
        <div class="col-lg-5">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <i class="bi bi-wind" style="color:var(--accent);"></i> Current Wind Speed
                </div>
                <div class="card-body-custom text-center">

                    <!-- SVG Arc Gauge -->
                    <div class="gauge-container">
                        <svg class="gauge-arc" viewBox="0 0 260 140">
                            <!-- Background arc -->
                            <path d="M 20 130 A 110 110 0 0 1 240 130"
                                  fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="18" stroke-linecap="round"/>
                            <!-- Colored arc (decorative zones) -->
                            <path d="M 20 130 A 110 110 0 0 1 100 28"
                                  fill="none" stroke="#68d391" stroke-width="18" stroke-linecap="round" opacity=".7"/>
                            <path d="M 100 28 A 110 110 0 0 1 190 35"
                                  fill="none" stroke="#f6ad55" stroke-width="18" stroke-linecap="round" opacity=".7"/>
                            <path d="M 190 35 A 110 110 0 0 1 240 130"
                                  fill="none" stroke="#fc8181" stroke-width="18" stroke-linecap="round" opacity=".7"/>
                            <!-- Zone labels -->
                            <text x="18"  y="148" fill="#68d391" font-size="10" font-family="Inter">0</text>
                            <text x="113" y="22"  fill="#f6ad55" font-size="10" font-family="Inter" text-anchor="middle">15</text>
                            <text x="234" y="148" fill="#fc8181" font-size="10" font-family="Inter">30</text>
                        </svg>
                        <!-- Needle overlaid via CSS -->
                        <div class="gauge-needle" id="gauge-needle"></div>
                    </div>

                    <!-- Numeric Speed Display -->
                    <div class="speed-display">
                        <div class="speed-value" id="wind-speed-value">—</div>
                        <div class="speed-unit">m/s</div>
                    </div>

                    <!-- Sensor metadata -->
                    <div class="d-flex justify-content-center gap-4 mt-3 text-muted small">
                        <span><i class="bi bi-cpu me-1"></i>Sensor: <strong id="sensor-id">—</strong></span>
                        <span><i class="bi bi-tag me-1"></i>Type: <strong id="is-simulated">—</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-lg-7">
            <div class="row g-3 h-100 align-content-start">
                <div class="col-6">
                    <div class="stat-card">
                        <div class="stat-label"><i class="bi bi-arrow-up-circle me-1"></i>Max Today</div>
                        <div class="stat-value" id="stat-max-today">@(Model.Any() ? Model.Max(r => r.WindSpeed).ToString("F2") + " m/s" : "—")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card">
                        <div class="stat-label"><i class="bi bi-arrow-down-circle me-1"></i>Min Today</div>
                        <div class="stat-value" id="stat-min-today" style="color:var(--accent-2);">@(Model.Any() ? Model.Min(r => r.WindSpeed).ToString("F2") + " m/s" : "—")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card">
                        <div class="stat-label"><i class="bi bi-calculator me-1"></i>Average</div>
                        <div class="stat-value" id="stat-avg" style="color:var(--warning);">@(Model.Any() ? Model.Average(r => r.WindSpeed).ToString("F2") + " m/s" : "—")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-card">
                        <div class="stat-label"><i class="bi bi-database me-1"></i>Readings</div>
                        <div class="stat-value" style="color:var(--success);">@Model.Count()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest 10 Readings Table -->
    <div class="glass-card fade-in-up">
        <div class="card-header-custom">
            <i class="bi bi-table" style="color:var(--accent);"></i> Latest 10 Readings
        </div>
        <div class="card-body-custom p-0">
            <div class="table-responsive">
                <table class="wind-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Wind Speed</th>
                            <th>Timestamp (UTC)</th>
                            <th>Sensor ID</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No readings yet.</td></tr>
                        }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="text-muted">@r.Id</td>
                                <td><strong style="color:var(--accent);">@r.WindSpeed.ToString("F2")</strong> m/s</td>
                                <td>@r.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(r.SensorId ?? "—")</td>
                                <td>
                                    @if (r.IsSimulated)
                                    {
                                        <span class="badge-simulated">Simulated</span>
                                    }
                                    else
                                    {
                                        <span class="badge-real">Real</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
