@* File: Views/Alerts/Index.cshtml *@
@model IEnumerable<WindMonitoringSystem.Models.AlertThreshold>
@{
    ViewData["Title"] = "Alerts & Notifications";
}

<div class="fade-in-up">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="mb-0" style="font-size:1.6rem;font-weight:700;">
            <i class="bi bi-bell me-2" style="color:var(--accent);"></i>Alerts & Notifications
        </h1>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="glass-card p-3 mb-4" style="border-color:rgba(104,211,145,0.3);background:rgba(104,211,145,0.07);">
            <p class="mb-0" style="color:var(--success);">@TempData["Message"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="glass-card p-3 mb-4" style="border-color:rgba(252,129,129,0.3);background:rgba(252,129,129,0.07);">
            <p class="mb-0" style="color:var(--danger);">@TempData["Error"]</p>
        </div>
    }

    <div class="row g-4">
        <!-- Create Alert -->
        <div class="col-lg-4">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <i class="bi bi-plus-circle" style="color:var(--accent);"></i> New Alert Rule
                </div>
                <div class="card-body-custom">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label small text-muted">Speed Threshold (m/s)</label>
                            <input type="number" step="0.1" name="speedThreshold" class="form-control bg-dark text-light border-secondary" placeholder="e.g. 20" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small text-muted">Notification Method</label>
                            <select name="notificationMethod" class="form-select bg-dark text-light border-secondary">
                                <option value="BrowserPush">Browser Notification (SignalR)</option>
                                <option value="Email">Email Alert</option>
                                <option value="SMS">SMS (Twilio)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-wind btn-wind-primary w-100">
                            <i class="bi bi-check-lg"></i> Create Alert Rule
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- My Alerts List -->
        <div class="col-lg-8">
            <div class="glass-card h-100">
                <div class="card-header-custom">
                    <i class="bi bi-list-stars" style="color:var(--accent);"></i> My Active Alerts
                </div>
                <div class="card-body-custom p-0">
                    <div class="table-responsive">
                        <table class="wind-table">
                            <thead>
                                <tr>
                                    <th>Threshold</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th>Last Triggered</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-4">You haven't set any alerts yet.</td></tr>
                                }
                                @foreach (var alert in Model)
                                {
                                    <tr>
                                        <td><strong style="color:var(--accent);">@alert.SpeedThreshold.ToString("F1")</strong> m/s</td>
                                        <td>
                                            @switch (alert.NotificationMethod)
                                            {
                                                case WindMonitoringSystem.Models.NotificationType.BrowserPush:
                                                    <i class="bi bi-window-stack me-1"></i><span>Browser</span>
                                                    break;
                                                case WindMonitoringSystem.Models.NotificationType.Email:
                                                    <i class="bi bi-envelope me-1"></i><span>Email</span>
                                                    break;
                                                case WindMonitoringSystem.Models.NotificationType.SMS:
                                                    <i class="bi bi-chat-left-text me-1"></i><span>SMS</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (alert.IsActive)
                                            {
                                                <span class="badge-real">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-simulated" style="background:rgba(255,255,255,0.05);color:var(--text-muted);">Paused</span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @(alert.LastTriggeredAt?.ToString("MMM dd, HH:mm") ?? "Never")
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form asp-action="Toggle" asp-route-id="@alert.Id" method="post">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary border-0">
                                                        <i class="bi @(alert.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="Delete" asp-route-id="@alert.Id" method="post" onsubmit="return confirm('Delete this alert?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Instructions -->
    <div class="glass-card mt-4 p-4">
        <h5 class="mb-3 small text-uppercase letter-spacing-1 text-muted">About Alerts</h5>
        <div class="row g-4 text-muted small">
            <div class="col-md-4">
                <p><strong><i class="bi bi-shield-check me-1"></i> Spam Protection:</strong> Alerts are capped at one notification every 15 minutes per rule to prevent flooding your inbox or device.</p>
            </div>
            <div class="col-md-4">
                <p><strong><i class="bi bi-lightning me-1"></i> Real-time:</strong> Browser notifications use SignalR for instant delivery without page refresh.</p>
            </div>
            <div class="col-md-4">
                <p><strong><i class="bi bi-envelope me-1"></i> Email/SMS:</strong> Ensure your profile has a valid email address and phone number for these methods.</p>
            </div>
        </div>
    </div>
</div>
