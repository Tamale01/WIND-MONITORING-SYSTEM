@* File: Views/Home/Index.cshtml *@
@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<section class="hero fade-in-up">
    <div class="mb-4">
        <span style="font-size:4rem;">🌬️</span>
    </div>
    <h1 class="hero-title">Wind Monitoring System</h1>
    <p class="hero-subtitle">
        Real-time wind speed monitoring, historical analytics, and sensor integration
        — all in one powerful dashboard.
    </p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn-wind btn-wind-primary" id="go-dashboard">
                <i class="bi bi-speedometer2"></i> Open Dashboard
            </a>
            <a asp-controller="Charts" asp-action="Index" class="btn-wind" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary);" id="go-charts">
                <i class="bi bi-bar-chart-line"></i> View Charts
            </a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn-wind btn-wind-primary" id="get-started">
                <i class="bi bi-rocket-takeoff"></i> Get Started
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-wind" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary);" id="sign-in">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </a>
        }
    </div>
</section>

<!-- System Status (public) -->
<section class="mb-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-3 col-6">
            <div class="stat-card fade-in-up">
                <div class="stat-label">System Status</div>
                <div class="stat-value" style="color:var(--success);font-size:1.1rem;">🟢 Online</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card fade-in-up">
                <div class="stat-label">Sensor</div>
                <div class="stat-value" style="font-size:1.1rem;">SIM-001</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card fade-in-up">
                <div class="stat-label">Update Rate</div>
                <div class="stat-value" style="font-size:1.1rem;">10s</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card fade-in-up">
                <div class="stat-label">Unit</div>
                <div class="stat-value" style="font-size:1.1rem;">m/s</div>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="mb-5">
    <h2 class="text-center mb-4" style="font-weight:700;">Features</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="glass-card h-100 p-4 text-center fade-in-up">
                <div class="feature-icon">⚡</div>
                <h5 class="mb-2">Live Dashboard</h5>
                <p class="text-muted small">Wind speed auto-refreshes every 5 seconds with an animated gauge display.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100 p-4 text-center fade-in-up">
                <div class="feature-icon">📊</div>
                <h5 class="mb-2">Historical Charts</h5>
                <p class="text-muted small">Interactive Chart.js line charts with 6h / 24h / 7d range pickers and statistics.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100 p-4 text-center fade-in-up">
                <div class="feature-icon">🔌</div>
                <h5 class="mb-2">REST API</h5>
                <p class="text-muted small">Submit real sensor data via POST /api/wind with API key authentication.</p>
            </div>
        </div>
    </div>
</section>
